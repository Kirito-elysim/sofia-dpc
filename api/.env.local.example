# Copy to .env.local (git-ignored). Real mails through your Gmail account:
# 1. Enable 2-Step Verification on the Google account, 2. create an "App password"
#    (https://myaccount.google.com/apppasswords), 3. put it below (no spaces; urlencode special chars).
# Gmail only lets you send From the authenticated address or a configured "Send mail as" alias,
# so Organization.emailFrom must be that address (or an alias).
MAILER_DSN=gmail://YOUR_ADDRESS%40gmail.com:YOUR_APP_PASSWORD@default
SEED_SOFIA_FROM=your.address@gmail.com
SEED_PHOCEA_FROM=your.address@gmail.com

# One profile per Zoom application. Use environment secrets in production.
# Never put credentials in the frontend, a commit, an issue or the handoff.
ZOOM_PROFILES='{"ZOOM_1":{"account_id":"","client_id":"","client_secret":"","webhook_secret":""}}'
ZOOM_BUFFER_MINUTES=0
